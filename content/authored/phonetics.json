{
  "sounds": [
    {"ipa": "iː", "kind": "vowel", "words": ["see", "eat", "green"], "tip": "Long and tense, like a long Turkish \"i\". Smile slightly.", "tipTr": "Uzun ve gergin \"i\". Hafifçe gülümser gibi. sheep /ʃiːp/ ≠ ship /ʃɪp/.", "hard": true},
    {"ipa": "ɪ", "kind": "vowel", "words": ["sit", "big", "fish"], "tip": "Short and relaxed, between Turkish \"i\" and \"e\".", "tipTr": "Kısa ve gevşek; Türkçe \"i\" ile \"e\" arası. Türkçe \"i\" gibi söylerseniz ship, sheep'e benzer.", "hard": true},
    {"ipa": "e", "kind": "vowel", "words": ["bed", "red", "said"], "tip": "Like Turkish \"e\" in \"ev\".", "tipTr": "Türkçe \"ev\" kelimesindeki e.", "hard": false},
    {"ipa": "æ", "kind": "vowel", "words": ["cat", "bad", "apple"], "tip": "Open your mouth wide, between \"a\" and \"e\".", "tipTr": "Ağzı geniş açarak \"a\" ile \"e\" arası bir ses. Türkçede yok: bad /bæd/ ≠ bed /bed/.", "hard": true},
    {"ipa": "ʌ", "kind": "vowel", "words": ["cup", "love", "money"], "tip": "A short central \"a\".", "tipTr": "Kısa, ağzın ortasında bir \"a\". cup /kʌp/ ≠ cap /kæp/.", "hard": true},
    {"ipa": "ɑː", "kind": "vowel", "words": ["car", "father", "start"], "tip": "A long open \"a\" from the back of the mouth.", "tipTr": "Uzun ve açık, boğaza yakın bir \"a\".", "hard": false},
    {"ipa": "ɒ", "kind": "vowel", "words": ["hot", "dog", "stop"], "tip": "Short rounded \"o\" (British).", "tipTr": "Kısa, yuvarlak \"o\" (İngiliz İngilizcesi). Amerikan aksanında genelde /ɑː/ olur.", "hard": false},
    {"ipa": "ɔː", "kind": "vowel", "words": ["four", "law", "walk"], "tip": "Long rounded \"o\".", "tipTr": "Uzun ve yuvarlak \"o\".", "hard": false},
    {"ipa": "ʊ", "kind": "vowel", "words": ["book", "put", "good"], "tip": "Short relaxed \"u\".", "tipTr": "Kısa ve gevşek \"u\". full /fʊl/ ≠ fool /fuːl/.", "hard": true},
    {"ipa": "uː", "kind": "vowel", "words": ["food", "blue", "you"], "tip": "Long \"u\" with rounded lips.", "tipTr": "Dudaklar yuvarlak, uzun \"u\".", "hard": false},
    {"ipa": "ɜː", "kind": "vowel", "words": ["bird", "work", "learn"], "tip": "A long central sound, close to Turkish \"ö\" with relaxed lips.", "tipTr": "Türkçe \"ö\" sesine yakın ama dudaklar yuvarlanmaz. work /wɜːk/ ≠ walk /wɔːk/.", "hard": true},
    {"ipa": "ə", "kind": "vowel", "words": ["about", "banana", "teacher"], "tip": "Schwa: the most common English vowel. Short, weak, unstressed.", "tipTr": "Schwa: İngilizcenin en sık ünlüsü. Kısa, zayıf, vurgusuz bir \"ı\" gibi. Türkçe konuşanlar her harfi tam okuma eğiliminde; vurgusuz heceleri zayıflatmak doğal aksanın anahtarıdır.", "hard": true},
    {"ipa": "eɪ", "kind": "diphthong", "words": ["day", "name", "rain"], "tip": "Glide from \"e\" to \"i\".", "tipTr": "\"e\"den \"i\"ye kayan ses: \"ey\".", "hard": false},
    {"ipa": "aɪ", "kind": "diphthong", "words": ["my", "time", "buy"], "tip": "Glide from \"a\" to \"i\".", "tipTr": "\"ay\" gibi.", "hard": false},
    {"ipa": "ɔɪ", "kind": "diphthong", "words": ["boy", "coin", "enjoy"], "tip": "Glide from \"o\" to \"i\".", "tipTr": "\"oy\" gibi.", "hard": false},
    {"ipa": "aʊ", "kind": "diphthong", "words": ["now", "house", "out"], "tip": "Glide from \"a\" to \"u\".", "tipTr": "\"av\" ile \"au\" arası.", "hard": false},
    {"ipa": "əʊ", "kind": "diphthong", "words": ["go", "home", "know"], "tip": "Glide from schwa to \"u\" (British). American: oʊ.", "tipTr": "İngiliz: \"ıu\", Amerikan: \"ou\". Düz bir \"o\" söylemeyin: go ≠ \"go\".", "hard": true},
    {"ipa": "ɪə", "kind": "diphthong", "words": ["near", "here", "idea"], "tip": "Glide from \"ɪ\" to schwa (British).", "tipTr": "\"iı\" gibi (İngiliz).", "hard": false},
    {"ipa": "eə", "kind": "diphthong", "words": ["hair", "care", "where"], "tip": "Glide from \"e\" to schwa (British).", "tipTr": "\"eı\" gibi (İngiliz).", "hard": false},
    {"ipa": "ʊə", "kind": "diphthong", "words": ["tour", "pure", "cure"], "tip": "Glide from \"ʊ\" to schwa (often /ɔː/ today).", "tipTr": "\"uı\" gibi; bugün çoğu zaman /ɔː/ söylenir.", "hard": false},
    {"ipa": "p", "kind": "consonant", "words": ["pen", "happy", "stop"], "tip": "With a puff of air at the start of a stressed syllable.", "tipTr": "Vurgulu hece başında hafif bir hava püskürmesiyle.", "hard": false},
    {"ipa": "b", "kind": "consonant", "words": ["bad", "baby", "job"], "tip": "Like Turkish \"b\". Keep it voiced at the end of words.", "tipTr": "Türkçe \"b\". Kelime sonunda \"p\"ye çevirmeyin: job ≠ \"jop\".", "hard": false},
    {"ipa": "t", "kind": "consonant", "words": ["ten", "water", "cat"], "tip": "Tongue behind the top teeth. In American English, between vowels it can sound like a quick \"d\".", "tipTr": "Dil üst dişlerin arkasında. Amerikan aksanında iki ünlü arasında hızlı bir \"d\" gibi: water \"wadır\".", "hard": false},
    {"ipa": "d", "kind": "consonant", "words": ["dog", "ladder", "bed"], "tip": "Voiced; don't turn it into \"t\" at the end.", "tipTr": "Kelime sonunda \"t\"ye çevirmeyin: bed ≠ bet.", "hard": true},
    {"ipa": "k", "kind": "consonant", "words": ["cat", "school", "back"], "tip": "Like Turkish \"k\".", "tipTr": "Türkçe \"k\".", "hard": false},
    {"ipa": "ɡ", "kind": "consonant", "words": ["go", "bigger", "dog"], "tip": "Voiced; keep it at the end of words.", "tipTr": "Sonda \"k\"ye çevirmeyin: dog ≠ dock.", "hard": false},
    {"ipa": "f", "kind": "consonant", "words": ["fish", "coffee", "laugh"], "tip": "Top teeth on the bottom lip.", "tipTr": "Üst dişler alt dudağa değer.", "hard": false},
    {"ipa": "v", "kind": "consonant", "words": ["very", "river", "love"], "tip": "Top teeth touch the bottom lip and the sound vibrates. Not \"w\".", "tipTr": "Üst dişler alt dudağa değer ve titreşir. \"w\" ile karıştırmayın: very ≠ \"wery\", vine ≠ wine.", "hard": true},
    {"ipa": "θ", "kind": "consonant", "words": ["think", "three", "bath"], "tip": "Tongue tip between the teeth, blow air. No voice.", "tipTr": "Dil ucu dişlerin arasında, sessizce hava üfleyin. \"t\" ya da \"s\" değil: think ≠ \"tink\"/\"sink\".", "hard": true},
    {"ipa": "ð", "kind": "consonant", "words": ["this", "mother", "with"], "tip": "Tongue between the teeth, with voice.", "tipTr": "Dil dişlerin arasında, titreşimli. \"d\" ya da \"z\" değil: they ≠ \"dey\".", "hard": true},
    {"ipa": "s", "kind": "consonant", "words": ["see", "class", "city"], "tip": "Like Turkish \"s\".", "tipTr": "Türkçe \"s\".", "hard": false},
    {"ipa": "z", "kind": "consonant", "words": ["zoo", "easy", "is"], "tip": "Voiced \"s\". Plural -s is often /z/: dogs /dɒɡz/.", "tipTr": "Titreşimli s. Çoğul -s çoğu zaman /z/ okunur: dogs \"dogz\", is \"iz\".", "hard": true},
    {"ipa": "ʃ", "kind": "consonant", "words": ["she", "sugar", "fish"], "tip": "Like Turkish \"ş\".", "tipTr": "Türkçe \"ş\".", "hard": false},
    {"ipa": "ʒ", "kind": "consonant", "words": ["vision", "measure", "usually"], "tip": "Like Turkish \"j\" in \"jale\".", "tipTr": "\"Jale\"deki j.", "hard": false},
    {"ipa": "h", "kind": "consonant", "words": ["hat", "behind", "who"], "tip": "A soft breath, lighter than Turkish \"h\".", "tipTr": "Türkçe \"h\"den daha hafif, sadece nefes.", "hard": false},
    {"ipa": "tʃ", "kind": "consonant", "words": ["chair", "teacher", "watch"], "tip": "Like Turkish \"ç\".", "tipTr": "Türkçe \"ç\".", "hard": false},
    {"ipa": "dʒ", "kind": "consonant", "words": ["job", "age", "bridge"], "tip": "Like Turkish \"c\".", "tipTr": "Türkçe \"c\".", "hard": false},
    {"ipa": "m", "kind": "consonant", "words": ["man", "summer", "time"], "tip": "Like Turkish \"m\".", "tipTr": "Türkçe \"m\".", "hard": false},
    {"ipa": "n", "kind": "consonant", "words": ["no", "dinner", "sun"], "tip": "Like Turkish \"n\".", "tipTr": "Türkçe \"n\".", "hard": false},
    {"ipa": "ŋ", "kind": "consonant", "words": ["sing", "thinking", "long"], "tip": "Back of the tongue up, sound through the nose. Usually no \"g\" after it.", "tipTr": "Genizden gelen \"n\"; arkasından \"g\" okunmaz: sing \"sin(g)\", \"sing-g\" değil.", "hard": true},
    {"ipa": "l", "kind": "consonant", "words": ["leg", "hello", "feel"], "tip": "At the end of words it is \"dark\", like the Turkish \"l\" in \"kal\".", "tipTr": "Kelime sonunda kalın l, Türkçe \"kal\" kelimesindeki gibi.", "hard": false},
    {"ipa": "r", "kind": "consonant", "words": ["red", "sorry", "car"], "tip": "The tongue doesn't touch the roof of the mouth; no rolling. British English drops it after vowels (car /kɑː/).", "tipTr": "Dil damağa değmez, Türkçedeki gibi titretilmez. İngiliz aksanında ünlüden sonra okunmaz (car /kɑː/), Amerikan aksanında okunur.", "hard": true},
    {"ipa": "w", "kind": "consonant", "words": ["we", "away", "one"], "tip": "Round your lips like \"u\" and move quickly. Teeth don't touch the lip.", "tipTr": "Dudakları \"u\" gibi yuvarlayıp hızlıca açın; dişler dudağa değmez. wet ≠ vet.", "hard": true},
    {"ipa": "j", "kind": "consonant", "words": ["yes", "you", "use"], "tip": "Like Turkish \"y\".", "tipTr": "Türkçe \"y\".", "hard": false}
