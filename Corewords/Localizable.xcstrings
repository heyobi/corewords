    "10 new words a day is about 3,600 a year. Reviews come on top and are what make words stick.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde 10 yeni kelime yılda yaklaşık 3.600 eder. Tekrarlar bunun üstüne gelir ve kelimeleri kalıcı yapan da onlardır."
          }
        }
      }
    },
    "10 words · Steady": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
