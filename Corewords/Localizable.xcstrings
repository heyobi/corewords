    "Corewords listens on your device to check how you pronounce a word. Nothing is recorded or sent anywhere.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corewords, bir kelimeyi nasıl telaffuz ettiğinizi kontrol etmek için cihazınızda dinler. Hiçbir şey kaydedilmez ya da bir yere gönderilmez."
          }
        }
      }
    },
